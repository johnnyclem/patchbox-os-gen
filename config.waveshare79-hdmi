# Profile D: Pi + Waveshare 7.9" HDMI LCD (native 400×1280) + Pimidi
#
# Overlay on top of base `config` (IMG_NAME, stages, config.local).
#
# Stack (physical):
#   Raspberry Pi
#     └── Blokas Pimidi (40-pin) — 2×2 TRS MIDI  [optional but default ON]
#     └── Waveshare 7.9inch HDMI LCD
#           · HDMI video (native 400×1280)
#           · USB touch (capacitive)
#           · optional 5V/2A on panel Power jack at high brightness
#
# Usage:
#   ./build-docker.sh -c config.waveshare79-hdmi
#
# Field fix an already-flashed card (no rebuild):
#   ./scripts/fix-waveshare79-bootfs.sh /Volumes/bootfs
#
# Wiki: https://www.waveshare.com/wiki/7.9inch_HDMI_LCD
#
# WHY NO kernel rotate=90 (important):
#   Wiki lite rotation (`video=…:400x1280M@60,rotate=90`) works for the
#   console/logo, but SDL kmsdrm (rk00pi) often still opens the *unrotated*
#   400×1280 mode while the app requests 1280×400. That wraps each scanline
#   three times (1280/400) → "3 portrait copies of a distorted UI", then the
#   DRM client dies and the panel goes black. Reliable path: match app size to
#   the native mode (portrait chrome — top transport / bottom tabs).

ENABLE_HDMI_ULTRAWIDE=1
ENABLE_HYPERPIXEL4=0
ENABLE_WAVESHARE_DPI=0

# App window is landscape 1280×400 (software orient in the app where needed).
# Kernel mode must stay native 400×1280 — DO NOT set HDMI_ROTATE with
# SDL kmsdrm: rotate=90 + app 1280×400 wraps scanlines then blacks the panel.
# See scripts/fix-waveshare79-bootfs.sh and stage3/09 notes.
HDMI_WIDTH=1280
HDMI_HEIGHT=400
HDMI_REFRESH=60

# Native panel pixels (cmdline video= token). Must match hdmi_timings.
HDMI_NATIVE_WIDTH=400
HDMI_NATIVE_HEIGHT=1280
# Empty — never kernel-rotate this glass under kmsdrm.
HDMI_ROTATE=
HDMI_CONNECTOR=HDMI-A-1
# Exact wiki mode line (do not substitute hdmi_cvt=1280 400)
HDMI_TIMINGS="400 0 70 10 60 1280 0 20 10 12 0 0 0 60 0 43000000 3"

# Pimidi is free on the 40-pin (HDMI does not steal GPIO)
ENABLE_PIMIDI=1
PIMIDI_SEL=1

ENABLE_RK00PI=1
ENABLE_RK00PI_SERVICE=1
ENABLE_RK00PI_BUTTON=0
RK00PI_HUB_PRESET=pimidi-2x2
ENABLE_RK00PI_AUTOHUB=1
RK00PI_WIDTH=1280
RK00PI_HEIGHT=400

ENABLE_RK00PI_COMPANION=1
RK00PI_COMPANION_BIND=0.0.0.0
RK00PI_COMPANION_PORT=8787
RK00PI_COMPANION_ADVERTISE=1

ENABLE_RASPIAUDIO=0
ENABLE_INKY=0
ENABLE_INKY_UI=0
ENABLE_INKY_STATUS_SERVICE=0
