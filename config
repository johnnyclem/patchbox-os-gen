IMG_NAME="Patchbox"
FIRST_USER_NAME="patch"
FIRST_USER_PASS="blokaslabs"
HOSTNAME="patchbox"

# SSH is a documented part of the Patchbox headless workflow (wifi hotspot +
# ssh for initial setup).
ENABLE_SSH="${ENABLE_SSH:-1}"

ENABLE_WIFI_HOTSPOT="${ENABLE_WIFI_HOTSPOT:-1}"
ENABLE_VNC="${ENABLE_VNC:-1}"
ENABLE_TELEMETRY="${ENABLE_TELEMETRY:-1}"

PISOUND_GIT_REF="${PISOUND_GIT_REF:-patchbox}"
HOTSPOT_PASSPHRASE="${HOTSPOT_PASSPHRASE:-blokaslabs}"
ENABLE_FIRST_LOGIN_PASSWORD_CHANGE="${ENABLE_FIRST_LOGIN_PASSWORD_CHANGE:-1}"

# --- Primary product stack ---
# Profile A (defaults below): Pi 5 + Pimidi + HDMI 1280×400 + USB touch
# Profile B: HyperPixel 4.0" 800×480 — config.hyperpixel4-pimidi.example
# Profile C: Waveshare 3.5" DPI 640×480 + Pimidi — config.waveshare35-pimidi.example
#   ./build-docker.sh -c config.waveshare35-pimidi

# HDMI ultrawide touch monitor (custom CVT mode)
ENABLE_HDMI_ULTRAWIDE="${ENABLE_HDMI_ULTRAWIDE:-1}"
HDMI_WIDTH="${HDMI_WIDTH:-1280}"
HDMI_HEIGHT="${HDMI_HEIGHT:-400}"
HDMI_REFRESH="${HDMI_REFRESH:-60}"

# Pimoroni HyperPixel 4.0" rectangular DPI (800×480 @ 60). Off by default.
# WARNING: DPI uses almost all 40-pin GPIO — stacking Pimidi is pin-contested.
ENABLE_HYPERPIXEL4="${ENABLE_HYPERPIXEL4:-0}"
HYPERPIXEL_WIDTH="${HYPERPIXEL_WIDTH:-800}"
HYPERPIXEL_HEIGHT="${HYPERPIXEL_HEIGHT:-480}"
HYPERPIXEL_REFRESH="${HYPERPIXEL_REFRESH:-60}"
# left = landscape 800×480 (matches app); none = portrait bring-up only
HYPERPIXEL_ROTATE="${HYPERPIXEL_ROTATE:-left}"
HYPERPIXEL_CMDLINE_VIDEO="${HYPERPIXEL_CMDLINE_VIDEO:-0}"
HYPERPIXEL_KEEP_PIMIDI="${HYPERPIXEL_KEEP_PIMIDI:-0}"

# Blokas Pimidi 2×2 TRS MIDI
ENABLE_PIMIDI="${ENABLE_PIMIDI:-1}"
PIMIDI_SEL="${PIMIDI_SEL:-0}"

# RK-00pi — main appliance (submodule: RK-00pi → git@github.com:johnnyclem/RK-00pi.git)
ENABLE_RK00PI="${ENABLE_RK00PI:-1}"
ENABLE_RK00PI_SERVICE="${ENABLE_RK00PI_SERVICE:-1}"
ENABLE_RK00PI_BUTTON="${ENABLE_RK00PI_BUTTON:-0}"
# Starter hub preset. A hub endpoint binds to an ALSA port by *client name*,
# so this has to agree with the HAT that is actually on the header: baking
# pimidi-2x2 onto a Pisound rig boots every DIN endpoint unbound and no note
# or clock moves in either direction. Follow ENABLE_PIMIDI unless told
# otherwise; rk008 is the single-DIN Pisound profile.
if [ "${ENABLE_PIMIDI}" = "1" ]; then
	RK00PI_HUB_PRESET="${RK00PI_HUB_PRESET:-pimidi-2x2}"
else
	RK00PI_HUB_PRESET="${RK00PI_HUB_PRESET:-rk008}"
fi
# Belt and braces for the same failure: rk00pi.service re-fits the hub to the
# live ALSA graph at every start (patchbox-rk00pi-autohub), which also picks
# up USB MIDI devices the baked preset knows nothing about. Set to 0 to boot
# strictly what the preset says. On the unit: /etc/rk00pi/autohub.disabled
ENABLE_RK00PI_AUTOHUB="${ENABLE_RK00PI_AUTOHUB:-1}"
# Companion web UI = remote MIDI routing matrix + backup (token auth, no TLS).
# Product default ON for the hot-swap hub story: bind 0.0.0.0, allow mid-set
# hub edits, optional mDNS. Set 0 for a stage image that must not listen.
ENABLE_RK00PI_COMPANION="${ENABLE_RK00PI_COMPANION:-1}"
RK00PI_COMPANION_BIND="${RK00PI_COMPANION_BIND:-0.0.0.0}"
RK00PI_COMPANION_PORT="${RK00PI_COMPANION_PORT:-8787}"
RK00PI_COMPANION_ADVERTISE="${RK00PI_COMPANION_ADVERTISE:-1}"
# Empty → HyperPixel / Waveshare / HDMI dims (same order as stage 10)
RK00PI_WIDTH="${RK00PI_WIDTH:-}"
RK00PI_HEIGHT="${RK00PI_HEIGHT:-}"

# ChordRanger — second appliance app (apps/chordranger in this repo).
# Chord pads + QY-style backing band + Orchid-style bass engine.
#
# Installed by default, NOT enabled by default: ChordRanger and RK-00pi both
# take the panel under SDL kmsdrm and only one can have it. The image ships
# both and boots whichever unit is enabled; swap on the device with
#   sudo patchbox-chordranger enable   /   disable
# To build an image that boots ChordRanger instead, set
#   ENABLE_CHORDRANGER_SERVICE=1   (the stage disables rk00pi.service for you)
ENABLE_CHORDRANGER="${ENABLE_CHORDRANGER:-1}"
ENABLE_CHORDRANGER_SERVICE="${ENABLE_CHORDRANGER_SERVICE:-0}"
# Empty → HyperPixel / Waveshare / HDMI dims (same order as stage 10)
CHORDRANGER_WIDTH="${CHORDRANGER_WIDTH:-}"
CHORDRANGER_HEIGHT="${CHORDRANGER_HEIGHT:-}"

# --- Ranger suite (apps/rangerkit + six sibling apps) ---
# One kiosk app owns the panel; RANGER_BOOT_APP names the unit that boots.
# Everything else installs disabled and swaps on-device with
#   sudo patchbox-app enable <app>
# (ENABLE_CHORDRANGER_SERVICE=1 remains equivalent to
#  RANGER_BOOT_APP=chordranger for the shipped stage-13 path.)
RANGER_BOOT_APP="${RANGER_BOOT_APP:-rk00pi}"

# Per-app install toggles. Off until each app ships (its stage flips the
# default to 1 in the PR that lands it): six qemu venv builds and ~100 MB per
# app of venv on SDHC are not free.
ENABLE_MIDIRANGER="${ENABLE_MIDIRANGER:-1}"
ENABLE_GENRANGER="${ENABLE_GENRANGER:-1}"
ENABLE_PHRASERANGER="${ENABLE_PHRASERANGER:-1}"
ENABLE_SCENERANGER="${ENABLE_SCENERANGER:-1}"
ENABLE_GROOVERANGER="${ENABLE_GROOVERANGER:-1}"
ENABLE_SYNTHRANGER="${ENABLE_SYNTHRANGER:-1}"

# Per-app panel override; empty → HyperPixel / Waveshare / HDMI
# (same resolution order as RK-00pi and ChordRanger).
MIDIRANGER_WIDTH="${MIDIRANGER_WIDTH:-}"
MIDIRANGER_HEIGHT="${MIDIRANGER_HEIGHT:-}"
GENRANGER_WIDTH="${GENRANGER_WIDTH:-}"
GENRANGER_HEIGHT="${GENRANGER_HEIGHT:-}"
PHRASERANGER_WIDTH="${PHRASERANGER_WIDTH:-}"
PHRASERANGER_HEIGHT="${PHRASERANGER_HEIGHT:-}"
SCENERANGER_WIDTH="${SCENERANGER_WIDTH:-}"
SCENERANGER_HEIGHT="${SCENERANGER_HEIGHT:-}"
GROOVERANGER_WIDTH="${GROOVERANGER_WIDTH:-}"
GROOVERANGER_HEIGHT="${GROOVERANGER_HEIGHT:-}"
SYNTHRANGER_WIDTH="${SYNTHRANGER_WIDTH:-}"
SYNTHRANGER_HEIGHT="${SYNTHRANGER_HEIGHT:-}"

# Off: Waveshare 3.5" DPI 640×480 capacitive (Profile C — use config.waveshare35-pimidi)
ENABLE_WAVESHARE_DPI="${ENABLE_WAVESHARE_DPI:-0}"
WAVESHARE_WIDTH="${WAVESHARE_WIDTH:-640}"
WAVESHARE_HEIGHT="${WAVESHARE_HEIGHT:-480}"
WAVESHARE_REFRESH="${WAVESHARE_REFRESH:-60}"
# 1 = keep dtoverlay=pimidi with the DPI panel (experimental stack).
# 0 = packages only / strip pimidi DT (safer if panel or touch blacks out).
WAVESHARE_KEEP_PIMIDI="${WAVESHARE_KEEP_PIMIDI:-0}"

# Off: e-paper
ENABLE_INKY="${ENABLE_INKY:-0}"
ENABLE_INKY_UI="${ENABLE_INKY_UI:-0}"
ENABLE_INKY_STATUS_SERVICE="${ENABLE_INKY_STATUS_SERVICE:-0}"

# Off: RaspiAudio I2S
ENABLE_RASPIAUDIO="${ENABLE_RASPIAUDIO:-0}"
RASPIAUDIO_OVERLAY="${RASPIAUDIO_OVERLAY:-wm8960-soundcard}"

# Raspbian armhf mirror (primary host times out mid-build often)
RASPBIAN_MIRROR="${RASPBIAN_MIRROR:-http://mirrors.ocf.berkeley.edu/raspbian/raspbian}"

# --- Client WiFi (join your AP → SSH headless) ---
# Secrets: copy config.local.example → config.local (gitignored) and fill in.
# Or: WPA_COUNTRY=US WPA_ESSID='Net' WPA_PASSWORD='secret' ./build-docker.sh
#
# WPA_COUNTRY (2-letter ISO) is required to unblock the radio on Bookworm.
WPA_COUNTRY="${WPA_COUNTRY:-}"
WPA_ESSID="${WPA_ESSID:-}"
WPA_PASSWORD="${WPA_PASSWORD:-}"

# shellcheck disable=SC1091
_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)" || _CONFIG_DIR="."
if [ -f "${_CONFIG_DIR}/config.local" ]; then
	# shellcheck source=/dev/null
	. "${_CONFIG_DIR}/config.local"
fi

# When a home SSID is configured, turn off the Patchbox AP hotspot so the
# radio can join your network. Set FORCE_WIFI_HOTSPOT=1 in config.local to
# keep the hotspot enabled anyway.
if [ -n "${WPA_ESSID}" ] && [ "${FORCE_WIFI_HOTSPOT:-0}" != "1" ]; then
	ENABLE_WIFI_HOTSPOT=0
fi
