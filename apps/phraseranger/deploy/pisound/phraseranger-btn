#!/usr/bin/env python3
"""phraseranger-btn — send one button gesture to the running instrument.

``pisound-btn`` runs its action scripts as root under the *system* Python,
not the app's venv, so this client is stdlib-only and imports nothing from the
project. It writes one line to the Unix socket ``rangerkit.button.ButtonServer``
listens on and prints the reply.

    phraseranger-btn CLICK 2             # two clicks
    phraseranger-btn HOLD 1 3            # held ~3 s
    phraseranger-btn ACTION panic        # run an action directly, ignoring the map
    phraseranger-btn --map               # the live gesture -> action map
    phraseranger-btn --list              # action names the instrument knows
    phraseranger-btn PING                # is anything listening?

Exit status: 0 the action ran · 1 the instrument said no · 2 nothing was
listening. The socket is --socket, else $PHRASERANGER_BUTTON_SOCKET, else the
first of the standard paths that exists.
"""
import argparse
import os
import socket
import sys

CANDIDATES = (
    "/run/phraseranger/button.sock",
    "/var/lib/phraseranger/button.sock",
    "data/button.sock",
)
TIMEOUT_S = 6.0             # a save round-trip waits on the disk
# The hold thresholds pisound.conf itself uses. Anything else is HOLD_OTHER,
# which the map may bind or ignore.
HOLD_STEPS = (1, 3, 5)


def resolve_socket(explicit):
    if explicit:
        return explicit
    from_env = os.environ.get("PHRASERANGER_BUTTON_SOCKET", "").strip()
    if from_env:
        return from_env
    for path in CANDIDATES:
        if os.path.exists(path):
            return path
    return CANDIDATES[0]


def gesture_for(argv):
    """Turn pisound-btn's arguments into one gesture id.

    ``CLICK 2`` -> CLICK_2 · ``HOLD 1 3`` -> HOLD_3S · a bare word passes
    through so PING/MAP/ACTIONS and an explicit CLICK_2 both work.
    """
    verb = argv[0].upper()
    if verb == "CLICK":
        count = int(argv[1]) if len(argv) > 1 and argv[1].isdigit() else 1
        return f"CLICK_{count}" if count <= 3 else "CLICK_OTHER"
    if verb == "HOLD":
        seconds = int(argv[2]) if len(argv) > 2 and argv[2].isdigit() else 0
        held = max((s for s in HOLD_STEPS if s <= seconds), default=None)
        return f"HOLD_{held}S" if held else "HOLD_OTHER"
    if verb == "ACTION" and len(argv) > 1:
        return f"ACTION {argv[1]}"
    return verb


def main():
    parser = argparse.ArgumentParser(add_help=True, description=__doc__)
    parser.add_argument("words", nargs="*", default=["PING"])
    parser.add_argument("--socket", default="")
    parser.add_argument("--map", action="store_true",
                        help="print the live gesture map")
    parser.add_argument("--list", action="store_true",
                        help="print the action names")
    args = parser.parse_args()

    if args.map:
        request = "MAP"
    elif args.list:
        request = "ACTIONS"
    else:
        request = gesture_for(args.words or ["PING"])

    path = resolve_socket(args.socket)
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(TIMEOUT_S)
            sock.connect(path)
            sock.sendall((request + "\n").encode())
            reply = sock.recv(512).decode("utf-8", "replace").strip()
    except (FileNotFoundError, ConnectionRefusedError):
        # Exit 2, not 1: the shell wrappers use this to tell "no instrument
        # is running" apart from "the instrument refused", and only the first
        # of those should blink the LEDs.
        print(f"phraseranger-btn: nothing listening on {path}",
              file=sys.stderr)
        return 2
    except OSError as exc:
        print(f"phraseranger-btn: {exc}", file=sys.stderr)
        return 2
    print(reply)
    return 1 if reply.startswith("ERR") else 0


if __name__ == "__main__":
    sys.exit(main())
