# Example copy of Profile D — see config.waveshare79-hdmi for the full file.
# Build:
#   ./build-docker.sh -c config.waveshare79-hdmi
#
# Native 400×1280 + matching app size. Avoid kernel rotate=90 with kmsdrm
# (causes 3× wrapped UI then black — see config.waveshare79-hdmi comments).

ENABLE_HDMI_ULTRAWIDE=1
ENABLE_WAVESHARE_DPI=0
ENABLE_HYPERPIXEL4=0

HDMI_WIDTH=400
HDMI_HEIGHT=1280
HDMI_REFRESH=60
HDMI_NATIVE_WIDTH=400
HDMI_NATIVE_HEIGHT=1280
HDMI_ROTATE=
HDMI_TIMINGS="400 0 70 10 60 1280 0 20 10 12 0 0 0 60 0 43000000 3"

RK00PI_WIDTH=400
RK00PI_HEIGHT=1280
ENABLE_PIMIDI=1
