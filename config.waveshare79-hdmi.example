# Profile D example — full file: config.waveshare79-hdmi
# DRM native 400×1280; app 1280×400 + rotation=90 (software landscape).

ENABLE_HDMI_ULTRAWIDE=1
ENABLE_WAVESHARE_DPI=0
ENABLE_HYPERPIXEL4=0

HDMI_WIDTH=400
HDMI_HEIGHT=1280
HDMI_REFRESH=60
HDMI_NATIVE_WIDTH=400
HDMI_NATIVE_HEIGHT=1280
HDMI_ROTATE=
HDMI_TIMINGS="400 0 70 10 60 1280 0 20 10 12 0 0 0 60 0 43000000 3"

RK00PI_WIDTH=1280
RK00PI_HEIGHT=400
RK00PI_ROTATION=90
ENABLE_PIMIDI=1
