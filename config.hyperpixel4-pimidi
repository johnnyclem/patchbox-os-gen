# Profile B: Pi 5 + HyperPixel 4.0" 800×480 DPI (display-first)
# Usage:
#   ./build-docker.sh -c config.hyperpixel4-pimidi
#   ./build-docker.sh config.hyperpixel4-pimidi   # bare path also works
#
# WiFi / secrets: keep them in config.local (always sourced via the default
# config). Do NOT blank WPA_* here — that used to wipe client WiFi when this
# file was passed as -c.
#
# GPIO: HyperPixel owns the 40-pin. Stage 12 strips dtoverlay=pimidi so the
# panel can light. Use USB MIDI here; use Profile A (HDMI) for TRS Pimidi.

IMG_NAME="Patchbox"
FIRST_USER_NAME="patch"
FIRST_USER_PASS="blokaslabs"
HOSTNAME="patchbox"

ENABLE_SSH=1
ENABLE_WIFI_HOTSPOT=0
ENABLE_VNC=1
ENABLE_TELEMETRY=1
ENABLE_FIRST_LOGIN_PASSWORD_CHANGE=1

PISOUND_GIT_REF="patchbox"
HOTSPOT_PASSPHRASE="blokaslabs"

# Display: HyperPixel only (no forced HDMI bar mode)
ENABLE_HDMI_ULTRAWIDE=0
ENABLE_HYPERPIXEL4=1
ENABLE_WAVESHARE_DPI=0
HYPERPIXEL_WIDTH=800
HYPERPIXEL_HEIGHT=480
HYPERPIXEL_REFRESH=60
# left/270 = landscape FB (800×480) matching the app. none leaves a portrait
# 480×800 mode (panel paints but UI is sideways). Use none only for black-screen
# bring-up: sudo patchbox-fix-hyperpixel4 --rotate none
HYPERPIXEL_ROTATE=left
# Do not force video=DPI-1:… (wrong mode → black). Overlay carries timings.
HYPERPIXEL_CMDLINE_VIDEO=0
# Do not keep pimidi DT on the header (GPIO clash → black panel).
HYPERPIXEL_KEEP_PIMIDI=0

# MIDI packages only — DT overlay dropped while HyperPixel is primary
ENABLE_PIMIDI=1
PIMIDI_SEL=0

# App
ENABLE_RK00PI=1
ENABLE_RK00PI_SERVICE=1
ENABLE_RK00PI_BUTTON=0
# USB MIDI / software ports until a non-DPI MIDI path is attached
RK00PI_HUB_PRESET=pimidi-2x2
# rk00pi.service re-fits the hub to the live ALSA graph at each start,
# so a unit built for Pimidi still binds if it boots on another HAT.
ENABLE_RK00PI_AUTOHUB=1
RK00PI_WIDTH=800
RK00PI_HEIGHT=480

ENABLE_INKY=0
ENABLE_INKY_UI=0
ENABLE_INKY_STATUS_SERVICE=0
ENABLE_RASPIAUDIO=0

RASPBIAN_MIRROR=http://mirrors.ocf.berkeley.edu/raspbian/raspbian
