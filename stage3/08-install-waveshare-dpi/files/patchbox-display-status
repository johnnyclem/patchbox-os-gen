#!/bin/bash
# Diagnostics for Waveshare 3.5" DPI + touch on Patchbox.
set -euo pipefail

echo "=== config.txt display overlays ==="
if [ -f /boot/firmware/config.txt ]; then
	grep -E '^(#)?dtoverlay=(vc4|waveshare|spi0|i2c1|wm8960|googlevoice)|^(#)?dtparam=(spi|i2s|i2c|audio)|hdmi_' \
		/boot/firmware/config.txt || true
else
	echo "(missing /boot/firmware/config.txt)"
fi

echo
echo "=== waveshare overlays present? ==="
ls -la /boot/firmware/overlays/waveshare*.dtbo \
	/boot/firmware/overlays/vc4-kms-DPI*.dtbo 2>/dev/null || echo "(none)"

echo
echo "=== DRM / connected connectors ==="
if command -v kmsprint >/dev/null 2>&1; then
	kmsprint 2>/dev/null || true
elif [ -d /sys/class/drm ]; then
	for c in /sys/class/drm/card*-*; do
		[ -e "$c/status" ] || continue
		echo "$(basename "$c"): $(cat "$c/status") $(cat "$c/enabled" 2>/dev/null || true)"
	done
else
	echo "(no DRM sysfs)"
fi

echo
echo "=== input devices (touch?) ==="
if command -v libinput >/dev/null 2>&1; then
	libinput list-devices 2>/dev/null | grep -E 'Device:|Capabilities:' | head -40 || true
fi
cat /proc/bus/input/devices 2>/dev/null | grep -E 'Name=|Handlers=' | head -40 || true

echo
echo "=== audio (expect USB when using DPI panel) ==="
aplay -l 2>/dev/null || true

echo
echo "Notes: DPI owns the 40-pin header — use USB audio. See ~/WAVESHARE-DPI.txt"
