#!/bin/bash
# Field-enable / re-orient Pimoroni HyperPixel 4 rectangular on a running image.
#
# Typical failure modes this fixes:
#   • Image was built for HDMI ultrawide (Profile A) → no DPI overlay
#   • Backlight flashes at power-on, then panel stays black
#   • Pimidi / i2c_arm / forced hdmi_* modes hold pins the DPI panel needs
#   • Panel paints but FB is portrait 480×800 while the app is 800×480
#     (sideways UI) — default --rotate 270 / left fixes that
#
# Usage:
#   sudo patchbox-fix-hyperpixel4              # landscape left (product default)
#   sudo patchbox-fix-hyperpixel4 --rotate 270  # same as default
#   sudo patchbox-fix-hyperpixel4 --rotate none # bare overlay if rotate blacks panel
#   sudo patchbox-fix-hyperpixel4 --keep-pimidi # NOT recommended (GPIO clash)
#   sudo patchbox-fix-hyperpixel4 --square      # HyperPixel 4 Square
#   sudo patchbox-fix-hyperpixel4 --video       # also set video=DPI-1:…
#
# After reboot: patchbox-hyperpixel-status
# Expect DPI modes to include 800x480 (not only 480x800).
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "run with sudo"; exit 1; }

# Product default: landscape FB matching RK-00pi / ranger 800×480.
ROT="left"
KEEP_PIMIDI=0
SQUARE=0
SET_VIDEO=0
W=800
H=480
R=60

while [ $# -gt 0 ]; do
	case "$1" in
		--rotate) ROT=$2; shift 2 ;;
		--keep-pimidi) KEEP_PIMIDI=1; shift ;;
		--square) SQUARE=1; W=720; H=720; shift ;;
		--video) SET_VIDEO=1; shift ;;
		--width) W=$2; shift 2 ;;
		--height) H=$2; shift 2 ;;
		-h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) echo "unknown: $1"; exit 1 ;;
	esac
done

CFG=/boot/firmware/config.txt
CMD=/boot/firmware/cmdline.txt
[ -f "$CFG" ] || CFG=/boot/config.txt
[ -f "$CFG" ] || { echo "missing config.txt under /boot/firmware or /boot"; exit 1; }
[ -f "$CMD" ] || CMD=/boot/cmdline.txt

TS=$(date +%Y%m%d%H%M%S)
cp -a "$CFG" "${CFG}.bak.${TS}"
[ -f "$CMD" ] && cp -a "$CMD" "${CMD}.bak.${TS}"

BASE="vc4-kms-dpi-hyperpixel4"
[ "$SQUARE" = "1" ] && BASE="vc4-kms-dpi-hyperpixel4sq"

# Verify overlay blob exists in firmware
for d in /boot/firmware/overlays /boot/overlays; do
	if [ -f "$d/${BASE}.dtbo" ]; then
		echo "overlay blob: $d/${BASE}.dtbo"
		break
	fi
done
if [ ! -f /boot/firmware/overlays/${BASE}.dtbo ] && [ ! -f /boot/overlays/${BASE}.dtbo ]; then
	echo "WARNING: ${BASE}.dtbo not found under /boot/*/overlays — display will stay black"
	echo "  apt install raspberrypi-kernel  (or update firmware package)"
fi

TMP=$(mktemp)
while IFS= read -r line || [ -n "$line" ]; do
	s="${line#"${line%%[![:space:]]*}"}"
	case "$s" in
		# DPI / HyperPixel (we rewrite)
		dtoverlay=vc4-kms-dpi-hyperpixel4*|dtoverlay=vc4-kms-dpi-hyperpixel4sq*|dtoverlay=vc4-kms-dpi-generic*)
			continue ;;
		# Forced HDMI modes (Profile A) fight DPI as primary
		hdmi_group=*|hdmi_mode=*|hdmi_cvt=*|hdmi_drive=*|hdmi_force_hotplug=*|hdmi_ignore_edid=*)
			continue ;;
		# Waveshare leftovers
		dtoverlay=waveshare-35dpi*|dtoverlay=waveshare-touch-35dpi*|dtoverlay=vc4-kms-DPI-35inch*)
			continue ;;
		# Pimidi claims I2C + GPIO that HyperPixel needs for DPI pinmux
		dtoverlay=pimidi*|dtparam=i2c_arm=*|dtparam=i2c_arm_baudrate=*|dtparam=spi=on)
			if [ "$KEEP_PIMIDI" = "1" ]; then
				: # keep
			else
				continue
			fi
			;;
		*'--- HyperPixel 4'*|*'--- end HyperPixel 4'*|*'--- HDMI ultrawide'*|*'--- end HDMI ultrawide'*|*'--- Pimidi'*|*'--- end Pimidi'*|*'--- Waveshare'*|*'--- end Waveshare'*)
			continue ;;
	esac
	printf '%s\n' "$line"
done < "$CFG" > "$TMP"

# Ensure KMS base + framebuffers
grep -qE '^dtoverlay=vc4-kms-v3d' "$TMP" || echo "dtoverlay=vc4-kms-v3d" >> "$TMP"
grep -qE '^max_framebuffers=' "$TMP" || echo "max_framebuffers=2" >> "$TMP"

# Explicitly leave arm I2C/SPI off (HyperPixel bitbangs its own touch bus)
if ! grep -qE '^#?dtparam=i2c_arm=' "$TMP"; then
	echo "#dtparam=i2c_arm=on   # off — HyperPixel owns DPI pins" >> "$TMP"
fi
if ! grep -qE '^#?dtparam=spi=' "$TMP"; then
	echo "#dtparam=spi=on       # off — HyperPixel owns DPI pins" >> "$TMP"
fi

OVERLAY="dtoverlay=${BASE}"
case "$ROT" in
	none|"") OVERLAY="dtoverlay=${BASE}" ;;
	0|normal) OVERLAY="dtoverlay=${BASE},rotate=0" ;;
	90|right) OVERLAY="dtoverlay=${BASE},rotate=90" ;;
	180|inverted) OVERLAY="dtoverlay=${BASE},rotate=180" ;;
	270|left) OVERLAY="dtoverlay=${BASE},rotate=270" ;;
	*) echo "bad --rotate $ROT (use none|0|90|180|270|left|right|normal|inverted)"; exit 1 ;;
esac

cat >> "$TMP" <<EOF

# --- HyperPixel 4 (field fix ${TS}) ---
# Official KMS path: https://learn.pimoroni.com/getting-started-with-hyperpixel-4
# GPIO: DPI uses ~28 pins — do NOT stack Pimidi/Pisound on the same header.
${OVERLAY}
# --- end HyperPixel 4 ---
EOF
cat "$TMP" > "$CFG"
rm -f "$TMP"

# cmdline: drop forced HDMI; video=DPI is optional (overlay usually sets timings)
if [ -f "$CMD" ]; then
	sed -E 's/ *video=HDMI-A-[12]:[^ ]*//g; s/ *video=DPI-1:[^ ]*//g; s/ *video=DSI-1:[^ ]*//g' \
		"$CMD" | tr -s ' ' | sed 's/^ //;s/ $//' > "${CMD}.1"
	if [ "$SET_VIDEO" = "1" ]; then
		if ! grep -q 'video=DPI-1:' "${CMD}.1"; then
			sed "s/^/video=DPI-1:${W}x${H}@${R}D /" "${CMD}.1" | tr -s ' ' | sed 's/ $//' > "$CMD"
		else
			cat "${CMD}.1" > "$CMD"
		fi
	else
		cat "${CMD}.1" > "$CMD"
	fi
	# ensure single trailing newline
	[ -n "$(tail -c1 "$CMD" 2>/dev/null)" ] && echo >> "$CMD" || true
	rm -f "${CMD}.1"
fi

# Point kiosk geometry at panel if configs exist (landscape dims).
for conf in /etc/rk00pi/config.toml /etc/chordranger/config.toml \
	/etc/midiranger/config.toml /etc/genranger/config.toml \
	/etc/phraseranger/config.toml; do
	if [ -f "$conf" ]; then
		sed -i -E "s/^(width\\s*=\\s*)[0-9]+/\\1${W}/; s/^(height\\s*=\\s*)[0-9]+/\\1${H}/" "$conf" 2>/dev/null || true
		echo "updated geometry in $conf → ${W}x${H}"
	fi
done

# Keep touch calibration in sync with display rotation (kmsdrm + X11).
case "$ROT" in
	left|270) MAT="0 -1 1 1 0 0"; XMAT="0 -1 1 1 0 0 0 0 1" ;;
	right|90) MAT="0 1 0 -1 0 1"; XMAT="0 1 0 -1 0 1 0 0 1" ;;
	inverted|180) MAT="-1 0 1 0 -1 1"; XMAT="-1 0 1 0 -1 1 0 0 1" ;;
	*) MAT="1 0 0 0 1 0"; XMAT="1 0 0 0 1 0 0 0 1" ;;
esac
install -d /etc/udev/hwdb.d
cat > /etc/udev/hwdb.d/61-hyperpixel4-touch.hwdb <<EOF
# HyperPixel 4 rectangular Goodix — match display rotation (${ROT})
evdev:name:*Goodix*:
evdev:name:*goodix*:
 LIBINPUT_CALIBRATION_MATRIX=${MAT}
EOF
echo "updated touch hwdb matrix for rotate=${ROT}: ${MAT}"
if command -v systemd-hwdb >/dev/null 2>&1; then
	systemd-hwdb update 2>/dev/null || true
elif command -v udevadm >/dev/null 2>&1; then
	udevadm hwdb --update 2>/dev/null || true
fi
if command -v udevadm >/dev/null 2>&1; then
	udevadm trigger 2>/dev/null || true
fi
if [ -d /etc/X11/xorg.conf.d ]; then
	cat > /etc/X11/xorg.conf.d/40-libinput-hyperpixel4.conf <<EOF
# HyperPixel 4 rectangular — Goodix (X11 / LightDM only). rotate=${ROT}
Section "InputClass"
	Identifier "HyperPixel4 Goodix"
	MatchProduct "Goodix"
	MatchIsTouchscreen "on"
	MatchDevicePath "/dev/input/event*"
	Driver "libinput"
	Option "CalibrationMatrix" "${XMAT}"
EndSection
EOF
	echo "updated X11 libinput calibration matrix"
fi

# Pi 5: kiosk SDL must open the DPI card (often not card0).
install -d /etc/systemd/system/rk00pi.service.d
cat > /etc/systemd/system/rk00pi.service.d/30-hyperpixel-kms.conf <<'EOF'
[Service]
# Pi 5 + HyperPixel: DPI is typically /dev/dri/card2
Environment=SDL_KMSDRM_DEVICE_INDEX=2
EOF
for unit in chordranger midiranger genranger phraseranger; do
	if [ -d "/etc/systemd/system/${unit}.service.d" ] || systemctl cat "${unit}.service" >/dev/null 2>&1; then
		install -d "/etc/systemd/system/${unit}.service.d"
		cp /etc/systemd/system/rk00pi.service.d/30-hyperpixel-kms.conf \
			"/etc/systemd/system/${unit}.service.d/30-hyperpixel-kms.conf"
	fi
done
systemctl daemon-reload 2>/dev/null || true

echo
echo "Wrote: ${OVERLAY}"
echo "config: $CFG  (backup ${CFG}.bak.${TS})"
[ -f "$CMD" ] && echo "cmdline: $(tr -d '\n' < "$CMD")"
if [ "$KEEP_PIMIDI" = "1" ]; then
	echo "NOTE: --keep-pimidi set — if panel stays black, re-run WITHOUT it."
else
	echo "Removed: hdmi_* force modes, dtoverlay=pimidi, dtparam=i2c_arm (GPIO free for DPI)."
	echo "MIDI: use USB host, or rebuild Profile A (HDMI + Pimidi)."
fi
echo
echo "Orientation: rotate=${ROT}  app geometry=${W}x${H}"
echo "  After reboot, patchbox-hyperpixel-status should list ${W}x${H} in DPI modes."
echo "  If still portrait (480x800) and UI sideways: try --rotate 90 (right)."
echo "  If panel goes black: sudo patchbox-fix-hyperpixel4 --rotate none && sudo reboot"
echo
echo "Reboot now:  sudo reboot"
echo "Then check:  patchbox-hyperpixel-status"
echo "             ls /sys/class/drm/card*-DPI-*/status"
echo "             dmesg | grep -iE 'dpi|hyperpixel|vc4|drm'"
exit 0
