#!/bin/bash
# patchbox-chordranger — kept for muscle memory; the work moved to
# patchbox-app (stage3/14), the one switcher that knows about *all* the
# kiosk apps. This wrapper translates the old verbs:
#
#   patchbox-chordranger status    ->  patchbox-app status
#   patchbox-chordranger enable    ->  patchbox-app enable chordranger
#   patchbox-chordranger disable   ->  patchbox-app disable
#   patchbox-chordranger button    ->  patchbox-app button chordranger
#   patchbox-chordranger logs      ->  patchbox-app logs chordranger
#
# Delegation matters beyond convenience: patchbox-app keeps the mutual-
# exclusion picture for all eight kiosk apps and owns the single
# pisound.conf backup slot, and two tools each keeping their own idea of
# "the base state" is how a button map gets eaten.
set -euo pipefail

APP_SWITCHER=/usr/local/bin/patchbox-app

usage() {
	echo "usage: patchbox-chordranger [status|enable|disable|button|logs]"
	echo "(a thin wrapper over: patchbox-app ... chordranger)"
}

if [ ! -x "${APP_SWITCHER}" ]; then
	echo "patchbox-chordranger: ${APP_SWITCHER} is missing." >&2
	echo "This image installed ChordRanger without the Ranger suite" >&2
	echo "switcher (stage3/14). Reinstall with that stage enabled, or" >&2
	echo "drive systemd directly:" >&2
	echo "  sudo systemctl disable --now rk00pi.service" >&2
	echo "  sudo systemctl enable --now chordranger.service" >&2
	exit 1
fi

case "${1:-status}" in
	status) exec "${APP_SWITCHER}" status ;;
	enable) exec "${APP_SWITCHER}" enable chordranger ;;
	disable) exec "${APP_SWITCHER}" disable ;;
	button) exec "${APP_SWITCHER}" button chordranger ;;
	logs) exec "${APP_SWITCHER}" logs chordranger ;;
	-h | --help | help) usage ;;
	*)
		usage >&2
		exit 2
		;;
esac
