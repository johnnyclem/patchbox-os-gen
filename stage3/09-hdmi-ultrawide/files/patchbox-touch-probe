#!/bin/bash
# patchbox-touch-probe — live USB-HID touch check for ElecLab / bar panels.
#
# Tells you whether the kernel sees the controller and whether events arrive
# when you tap. Does not need X or the rk00pi UI.
#
# Usage:
#   sudo patchbox-touch-probe           # 12 s listen on best candidate
#   sudo patchbox-touch-probe 20        # custom timeout seconds
#   patchbox-touch-probe --list         # devices only, no listen
set -euo pipefail

TIMEOUT="${1:-12}"
LIST_ONLY=0
if [ "${1:-}" = "--list" ] || [ "${1:-}" = "-l" ]; then
	LIST_ONLY=1
	TIMEOUT=0
fi

say()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
info() { printf '    %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
ok()   { printf '\033[1;32mok\033[0m  %s\n' "$*"; }
bad()  { printf '\033[1;31mno\033[0m  %s\n' "$*"; }

say "USB devices (look for HID / touch)"
if command -v lsusb >/dev/null 2>&1; then
	lsusb | sed 's/^/  /' || true
else
	warn "lsusb not installed"
fi
echo

say "Input devices (Name / Handlers)"
if [ -r /proc/bus/input/devices ]; then
	# Group Name= + Handlers= for readability
	awk '
		/^I:/ { if (n!="") print "  " n "  [" h "]"; n=""; h=""; bus=$0 }
		/^N: Name=/ { n=$0; sub(/^N: Name=/,"",n); gsub(/"/,"",n) }
		/^H: Handlers=/ { h=$0; sub(/^H: Handlers=/,"",h) }
		END { if (n!="") print "  " n "  [" h "]" }
	' /proc/bus/input/devices
else
	bad "/proc/bus/input/devices unreadable"
fi
echo

say "Permissions on /dev/input/event*"
ls -la /dev/input/event* 2>/dev/null | sed 's/^/  /' || info "(no event nodes)"
if id rk00pi >/dev/null 2>&1; then
	if id -nG rk00pi 2>/dev/null | tr ' ' '\n' | grep -qx input; then
		ok "rk00pi ∈ input"
	else
		bad "rk00pi NOT in input — UI paints, taps die under kmsdrm"
		info "fix: sudo patchbox-fix-input-button"
	fi
	if systemctl cat rk00pi.service >/dev/null 2>&1; then
		sg=$(systemctl show -p SupplementaryGroups --value rk00pi.service 2>/dev/null || true)
		if printf '%s\n' "$sg" | tr ' ' '\n' | grep -qx input; then
			ok "rk00pi.service SupplementaryGroups includes input"
		else
			bad "rk00pi.service missing SupplementaryGroups=input (groups=${sg:-?})"
			info "fix: sudo patchbox-fix-input-button"
		fi
	fi
fi
echo

# Pick best event node: prefer touchscreen/tablet in name, else any event*
pick_event() {
	local best="" name handlers
	while IFS= read -r line; do
		case "$line" in
			N:\ Name=*) name=${line#N: Name=}; name=${name//\"/} ;;
			H:\ Handlers=*)
				handlers=${line#H: Handlers=}
				ev=$(printf '%s\n' "$handlers" | grep -oE 'event[0-9]+' | head -1 || true)
				[ -n "$ev" ] || continue
				case "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" in
					*touch*|*goodix*|*ilitek*|*egalax*|*digitizer*|*fts*|*wave*)
						echo "/dev/input/$ev"
						return 0
						;;
				esac
				[ -z "$best" ] && best="/dev/input/$ev"
				;;
		esac
	done < /proc/bus/input/devices
	[ -n "$best" ] && echo "$best" && return 0
	# Fallback: first event node
	ls /dev/input/event* 2>/dev/null | head -1 || true
}

EVENT=$(pick_event || true)
if [ -z "${EVENT}" ] || [ ! -e "${EVENT}" ]; then
	bad "No /dev/input/event* node found"
	warn "ElecLab panels need the USB cable (HDMI alone = video only, no touch)."
	warn "Reseat USB to a Pi USB-A port (try USB2 if USB3 is flaky)."
	exit 1
fi

info "candidate device: ${EVENT}"
if [ -r /proc/bus/input/devices ]; then
	# Show the block that owns this event handler
	evbase=$(basename "$EVENT")
	awk -v e="$evbase" '
		BEGIN { RS=""; FS="\n" }
		$0 ~ ("\\<" e "\\>") { print; exit }
	' /proc/bus/input/devices | sed 's/^/  /' || true
fi
echo

if [ "$LIST_ONLY" -eq 1 ]; then
	say "List only — re-run without --list and tap the panel"
	exit 0
fi

if [ "$(id -u)" -ne 0 ] && [ ! -r "${EVENT}" ]; then
	bad "cannot read ${EVENT} — re-run with sudo"
	exit 1
fi

say "Listening ${TIMEOUT}s on ${EVENT} — TAP THE PANEL NOW"
info "expect ABS / BTN / SYN lines on each press"
if command -v timeout >/dev/null 2>&1 && command -v evtest >/dev/null 2>&1; then
	# evtest is clearest when available
	if timeout "${TIMEOUT}" evtest "${EVENT}" 2>&1 | tee /tmp/patchbox-touch-probe.log | tail -40; then
		:
	fi
	if grep -qE 'ABS_|BTN_TOUCH|BTN_LEFT|SYN_REPORT' /tmp/patchbox-touch-probe.log 2>/dev/null; then
		ok "events seen — kernel touch path is alive"
		info "if rk00pi UI still ignores taps: sudo patchbox-fix-input-button"
		info "and ensure /opt/rk00pi has FINGER→mouse (gui/app.py) + unit SDL_TOUCH_MOUSE_EVENTS=0"
		exit 0
	else
		bad "no touch events in ${TIMEOUT}s"
		warn "If USB is connected: try another port, or power-cycle the panel."
		warn "Confirm with: cat /proc/bus/input/devices | grep -i touch"
		exit 2
	fi
fi

# Fallback: hexdump a few reads (works without evtest)
if command -v timeout >/dev/null 2>&1; then
	info "(evtest missing — raw read; install: sudo apt install evtest)"
	if timeout "${TIMEOUT}" dd if="${EVENT}" bs=24 count=8 status=none 2>/dev/null | wc -c | awk '{print "  bytes read: "$1}'; then
		:
	fi
	# If we got any bytes, something moved
	bytes=$(timeout 1 dd if="${EVENT}" bs=24 count=1 status=none 2>/dev/null | wc -c || echo 0)
	if [ "${bytes:-0}" -gt 0 ]; then
		ok "raw bytes from ${EVENT} — device is producing events"
		exit 0
	fi
fi

# Last resort: python struct read via /dev/input if available
if command -v python3 >/dev/null 2>&1; then
	info "python3 listen ${TIMEOUT}s…"
	if python3 - "${EVENT}" "${TIMEOUT}" <<'PY'
import sys, struct, select, time, os
path, timeout = sys.argv[1], float(sys.argv[2])
fmt = "llHHi"
size = struct.calcsize(fmt)
fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
end = time.time() + timeout
count = 0
try:
    while time.time() < end:
        r, _, _ = select.select([fd], [], [], 0.25)
        if not r:
            continue
        data = os.read(fd, size)
        if len(data) < size:
            continue
        _, _, etype, code, value = struct.unpack(fmt, data)
        if etype == 0:  # EV_SYN
            continue
        count += 1
        print(f"  type={etype} code={code} value={value}")
        if count >= 12:
            break
finally:
    os.close(fd)
sys.exit(0 if count else 2)
PY
	then
		ok "events seen — kernel touch path is alive"
		exit 0
	else
		bad "no events in ${TIMEOUT}s on ${EVENT}"
		exit 2
	fi
fi

bad "no tool available to listen (install evtest or use python3)"
exit 1
