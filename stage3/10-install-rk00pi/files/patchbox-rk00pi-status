#!/bin/bash
# Quick health check for the RK-00pi appliance on Patchbox OS.
set -euo pipefail

echo "=== RK-00pi / Patchbox appliance ==="
echo "date: $(date -Is 2>/dev/null || date)"
echo

if [ -d /opt/rk00pi ]; then
	echo "install: /opt/rk00pi present"
	if [ -f /opt/rk00pi/.patchbox-source-commit ]; then
		echo "commit:  $(cat /opt/rk00pi/.patchbox-source-commit)"
	fi
	if [ -x /opt/rk00pi/venv/bin/python ]; then
		echo "python:  $(/opt/rk00pi/venv/bin/python -V 2>&1)"
		/opt/rk00pi/venv/bin/python - <<'PY' 2>/dev/null || echo "imports:  (partial — run under service for full path)"
import importlib
for m in ("pygame", "mido", "alsa_midi", "rtmidi", "gpiod"):
    try:
        importlib.import_module(m if m != "alsa_midi" else "alsa_midi")
        print(f"  ok  {m}")
    except Exception as e:
        print(f"  --  {m}: {e.__class__.__name__}")
PY
	else
		echo "python:  missing venv at /opt/rk00pi/venv"
	fi
else
	echo "install: /opt/rk00pi MISSING"
fi
echo

if [ -f /etc/rk00pi/config.toml ]; then
	echo "config:  /etc/rk00pi/config.toml"
	grep -E '^(width|height|fullscreen|data_dir|driver|backend|prefer_pisound|enabled|socket)' \
		/etc/rk00pi/config.toml 2>/dev/null | sed 's/^/  /' || true
	if grep -q '^\[button\.map\]' /etc/rk00pi/config.toml 2>/dev/null; then
		echo "  [button.map]"
		# Print mapped gestures until the next table header.
		awk '/^\[button\.map\]/{p=1;next} /^\[/{p=0} p && /^[A-Z_]/{print "    "$0}' \
			/etc/rk00pi/config.toml 2>/dev/null || true
	fi
else
	echo "config:  missing"
fi
echo

if systemctl cat rk00pi.service >/dev/null 2>&1; then
	echo "unit:    $(systemctl is-enabled rk00pi.service 2>/dev/null || echo unknown) / $(systemctl is-active rk00pi.service 2>/dev/null || echo unknown)"
	systemctl --no-pager -l status rk00pi.service 2>/dev/null | head -12 | sed 's/^/  /' || true
else
	echo "unit:    rk00pi.service not installed"
fi
echo

echo "=== The Button (PiSound) ==="
if [ -x /usr/local/bin/rk00pi-btn ]; then
	echo "client:  /usr/local/bin/rk00pi-btn present"
else
	echo "client:  rk00pi-btn MISSING (re-run stage or deploy/install.sh)"
fi
if systemctl cat pisound-btn.service >/dev/null 2>&1; then
	echo "daemon:  pisound-btn $(systemctl is-enabled pisound-btn 2>/dev/null || echo '?') / $(systemctl is-active pisound-btn 2>/dev/null || echo '?')"
else
	echo "daemon:  pisound-btn.service MISSING (install pisound-btn package)"
fi
if [ -f /etc/pisound.conf ]; then
	echo "pisound.conf click/hold map:"
	grep -E '^(CLICK_|HOLD_)' /etc/pisound.conf 2>/dev/null | sed 's/^/  /' || \
		echo "  (no CLICK_*/HOLD_* lines — button scripts not wired)"
else
	echo "pisound.conf: missing"
fi
if [ -S /run/rk00pi/button.sock ]; then
	echo "socket:  /run/rk00pi/button.sock (live)"
	if command -v rk00pi-btn >/dev/null 2>&1; then
		echo -n "  ping:  "
		rk00pi-btn PING 2>&1 || true
		echo "  live map:"
		rk00pi-btn --map 2>&1 | sed 's/^/    /' || true
	fi
else
	echo "socket:  /run/rk00pi/button.sock absent (is rk00pi running?)"
fi
if [ -r /sys/kernel/pisound/version ] || [ -d /sys/kernel/pisound ]; then
	echo "kernel:  /sys/kernel/pisound present"
	[ -r /sys/kernel/pisound/version ] && echo "  version: $(cat /sys/kernel/pisound/version 2>/dev/null)"
else
	echo "kernel:  /sys/kernel/pisound ABSENT — HAT/driver not loaded (button GPIO dead)"
fi
echo

echo "=== Touch / input groups (kmsdrm) ==="
if id rk00pi >/dev/null 2>&1; then
	echo "rk00pi groups: $(id -nG rk00pi 2>/dev/null || true)"
	if id -nG rk00pi 2>/dev/null | tr ' ' '\n' | grep -qx input; then
		echo "input group: ok (service user can read /dev/input/event*)"
	else
		echo "input group: MISSING on rk00pi — touch will not work under kmsdrm"
		echo "  fix: sudo usermod -aG input rk00pi && sudo systemctl restart rk00pi"
	fi
else
	echo "rk00pi user: missing"
fi
# What the running unit actually has (SupplementaryGroups= overrides login groups)
if systemctl show -p SupplementaryGroups rk00pi.service >/dev/null 2>&1; then
	echo "unit SupplementaryGroups: $(systemctl show -p SupplementaryGroups --value rk00pi.service 2>/dev/null || echo '?')"
fi
echo

echo "default target: $(systemctl get-default 2>/dev/null || echo '?')"
echo "display mode (cmdline):"
grep -oE 'video=HDMI-A-[12]:[^ ]+' /boot/firmware/cmdline.txt 2>/dev/null | sed 's/^/  /' || \
	grep -oE 'video=HDMI-A-[12]:[^ ]+' /boot/cmdline.txt 2>/dev/null | sed 's/^/  /' || \
	echo "  (none)"
echo
echo "MIDI / audio (best-effort):"
amidi -l 2>/dev/null | sed 's/^/  /' || true
aplay -l 2>/dev/null | head -20 | sed 's/^/  /' || true
echo

# The failure this catches: every DIN endpoint asking for a HAT that is not
# on this Pi. The devices all enumerate, the diagnostics screen lists them,
# and no note or clock moves because nothing ever bound.
echo "=== MIDI hub endpoints ==="
if [ -x /usr/local/sbin/patchbox-rk00pi-autohub ]; then
	/usr/local/sbin/patchbox-rk00pi-autohub 2>&1 | sed 's/^/  /' || true
	if [ -f /etc/rk00pi/autohub.disabled ]; then
		echo "  autohub: disabled by /etc/rk00pi/autohub.disabled"
	fi
else
	echo "  patchbox-rk00pi-autohub missing (re-run stage3/10-install-rk00pi)"
fi
echo

echo "Hints: journalctl -u rk00pi -b -n 80"
echo "       sudo systemctl restart rk00pi"
echo "       rk00pi-btn PING · rk00pi-btn --map · rk00pi-btn --list"
echo "       Desktop: sudo systemctl start lightdm  (stop rk00pi first if needed)"
