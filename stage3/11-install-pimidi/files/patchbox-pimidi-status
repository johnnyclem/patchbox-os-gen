#!/bin/bash
# patchbox-pimidi-status — is the Blokas Pimidi actually on the MIDI graph?
#
# The appliance hub binds by ALSA *name* (client "pimidi…", seq ports a/b).
# If the kernel never creates those ports, every DIN endpoint stays hollow and
# no note or clock moves — while Diagnostics still lists other USB gear.
#
# Usage:
#   patchbox-pimidi-status
#   sudo patchbox-pimidi-status --fix-sel 0   # rewrite dtoverlay sel + reboot tip
set -euo pipefail

FIX_SEL=""
while [ $# -gt 0 ]; do
	case "$1" in
		--fix-sel) FIX_SEL=$2; shift 2 ;;
		-h|--help)
			sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
			exit 0
			;;
		*) echo "unknown: $1"; exit 1 ;;
	esac
done

ok()   { printf '\033[1;32mok\033[0m  %s\n' "$*"; }
bad()  { printf '\033[1;31mno\033[0m  %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }
info() { printf '    %s\n' "$*"; }
say()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }

CFG=/boot/firmware/config.txt
[ -f "$CFG" ] || CFG=/boot/config.txt

# --- optional field rewrite ---------------------------------------------------
if [ -n "$FIX_SEL" ]; then
	[ "$(id -u)" -eq 0 ] || { echo "run --fix-sel with sudo"; exit 1; }
	case "$FIX_SEL" in
		0|1|2|3) ;;
		*) echo "sel must be 0..3 (hardware DIP/jumper on the Pimidi)"; exit 1 ;;
	esac
	TS=$(date +%Y%m%d%H%M%S)
	cp -a "$CFG" "${CFG}.bak.pimidi.${TS}"
	TMP=$(mktemp)
	while IFS= read -r line || [ -n "$line" ]; do
		s="${line#"${line%%[![:space:]]*}"}"
		case "$s" in
			dtoverlay=pimidi*|*'--- Pimidi'*|*'--- end Pimidi'*)
				continue ;;
			dtparam=i2c_arm=on,i2c_arm_baudrate=*)
				continue ;;
		esac
		printf '%s\n' "$line"
	done < "$CFG" > "$TMP"
	grep -qE '^dtoverlay=vc4-kms-v3d' "$TMP" || true
	cat >> "$TMP" <<EOF

# --- Pimidi 2x2 TRS MIDI (sel=${FIX_SEL}, field fix ${TS}) ---
# sel must match the board jumpers: https://blokas.io/pimidi/docs/advanced-configuration/
dtparam=i2c_arm=on,i2c_arm_baudrate=1000000
dtoverlay=pimidi,sel=${FIX_SEL}
# --- end Pimidi ---
EOF
	cat "$TMP" > "$CFG"
	rm -f "$TMP"
	# ensure i2c-dev
	if [ -f /etc/modules ] && ! grep -qE '^i2c-dev' /etc/modules; then
		echo i2c-dev >> /etc/modules
	fi
	echo "Wrote dtoverlay=pimidi,sel=${FIX_SEL}  (backup ${CFG}.bak.pimidi.${TS})"
	echo "Reboot now:  sudo reboot"
	echo "Then:        patchbox-pimidi-status"
	echo "             sudo patchbox-rk00pi-autohub --apply && sudo systemctl restart rk00pi"
	exit 0
fi

echo "=== Pimidi / boot ==="
if [ -f "$CFG" ]; then
	grep -nE 'pimidi|i2c_arm' "$CFG" || warn "no pimidi/i2c lines in $CFG"
else
	bad "no config.txt"
fi
SEL_LINE=$(grep -E '^dtoverlay=pimidi' "$CFG" 2>/dev/null | tail -1 || true)
if [ -n "$SEL_LINE" ]; then
	ok "overlay: $SEL_LINE"
	case "$SEL_LINE" in
		*sel=0*) EXP_CLIENT=pimidi0; EXP_SEL=0 ;;
		*sel=1*) EXP_CLIENT=pimidi1; EXP_SEL=1 ;;
		*sel=2*) EXP_CLIENT=pimidi2; EXP_SEL=2 ;;
		*sel=3*) EXP_CLIENT=pimidi3; EXP_SEL=3 ;;
		*) EXP_CLIENT=pimidi0; EXP_SEL=0 ;;
	esac
	info "expect ALSA client name containing: ${EXP_CLIENT} (sel=${EXP_SEL})"
else
	bad "dtoverlay=pimidi missing — kernel will never create MIDI ports"
	info "fix: sudo patchbox-pimidi-status --fix-sel 0   # match board jumpers"
fi
echo

echo "=== kernel module ==="
if lsmod 2>/dev/null | grep -q snd_pimidi; then
	ok "snd_pimidi loaded"
	lsmod | grep -E 'snd_pimidi|i2c_bcm|i2c_dev' || true
else
	bad "snd_pimidi not loaded"
	info "often means: wrong sel, missing overlay, or package not installed"
	info "try: dmesg | grep -iE 'pimidi|i2c' | tail -20"
fi
if ! lsmod 2>/dev/null | grep -q i2c_dev && ! ls /dev/i2c-* >/dev/null 2>&1; then
	warn "no /dev/i2c-* — i2c_arm may be off"
fi
echo

echo "=== cards / amidi ==="
if [ -r /proc/asound/cards ]; then
	grep -i pimidi /proc/asound/cards && ok "sound card 'pimidi' present" \
		|| bad "no pimidi card in /proc/asound/cards"
	cat /proc/asound/cards | sed 's/^/  /'
else
	warn "/proc/asound/cards unreadable"
fi
amidi -l 2>&1 | sed 's/^/  /' || true
echo

echo "=== sequencer clients (what the hub can bind) ==="
PIMIDI_SEEN=0
if [ -r /proc/asound/seq/clients ]; then
	# Show pimidi-related blocks; fall back to full client list head
	if grep -qi pimidi /proc/asound/seq/clients; then
		PIMIDI_SEEN=1
		ok "pimidi appears in the sequencer graph"
		awk '
			BEGIN { show=0 }
			/^Client / {
				show = (tolower($0) ~ /pimidi/)
			}
			show { print "  " $0 }
		' /proc/asound/seq/clients
	else
		bad "no 'pimidi' client in /proc/asound/seq/clients"
		info "clients present:"
		grep -E '^Client ' /proc/asound/seq/clients | sed 's/^/  /' || true
	fi
else
	warn "no /proc/asound/seq/clients — trying aconnect"
	aconnect -l 2>&1 | sed 's/^/  /' || true
	if aconnect -l 2>/dev/null | grep -qi pimidi; then
		PIMIDI_SEEN=1
	fi
fi
echo

echo "=== hub endpoints vs live graph ==="
if command -v patchbox-rk00pi-autohub >/dev/null 2>&1 || [ -x /usr/local/sbin/patchbox-rk00pi-autohub ]; then
	AH=$(command -v patchbox-rk00pi-autohub 2>/dev/null || echo /usr/local/sbin/patchbox-rk00pi-autohub)
	"$AH" 2>&1 | sed 's/^/  /' || true
else
	warn "patchbox-rk00pi-autohub not installed"
fi
echo

echo "=== dmesg (pimidi / i2c hints) ==="
dmesg 2>/dev/null | grep -iE 'pimidi|snd_pimidi|i2c.*fail|i2c.*error' | tail -15 | sed 's/^/  /' \
	|| info "(no pimidi lines in dmesg ring buffer)"
echo

echo "=== verdict ==="
if [ "${PIMIDI_SEEN}" -eq 1 ]; then
	ok "Kernel sees Pimidi. If the panel still has hollow DIN lamps:"
	info "sudo patchbox-rk00pi-autohub --apply && sudo systemctl restart rk00pi"
	info "or on panel: I/O → PORTS → AUTO FIT  /  DIN device → pimidi"
else
	bad "Kernel does NOT expose Pimidi MIDI ports — hub cannot bind them."
	echo
	info "Most common cause: dtoverlay sel ≠ board jumpers."
	info "  Board all-open / default → sel=0  → client pimidi0, ports a/b"
	info "  Your image may have been built with PIMIDI_SEL=1 (client pimidi1)."
	echo
	info "1) Check the physical SEL jumpers on the Pimidi (Blokas docs)."
	info "2) Match software:"
	info "     sudo patchbox-pimidi-status --fix-sel 0    # or 1/2/3"
	info "     sudo reboot"
	info "3) After reboot, confirm this script shows a pimidi client, then:"
	info "     sudo patchbox-rk00pi-autohub --apply && sudo systemctl restart rk00pi"
	info "4) Still nothing: reseat HAT, confirm no HyperPixel/other DPI stack"
	info "   stole the 40-pin, and:  apt policy pimidi ; dmesg | grep -i pimidi"
fi
echo
echo "See ~/PIMIDI.txt if present."
